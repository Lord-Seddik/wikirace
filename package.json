{
  "name": "wikirace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WikiRace: a competitive, multiplayer race across Wikipedia. One Cloudflare Worker (site + API + Durable Objects) with D1.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
