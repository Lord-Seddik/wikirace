// WikiRace: one Cloudflare Worker serves the site (static assets), the API, and the
// Durable Objects for live rooms + matchmaking. Data lives in D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wikirace",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Build the React client into ./dist before every deploy (and on `wrangler dev`),
  // so Workers Builds works even if the dashboard build command is left empty.
  "build": { "command": "npm run build:client", "watch_dir": ["src", "shared"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/daily, /room/ABCDE, ...) all get index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "wikirace.seddikbachounda.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wikirace",
      "database_id": "8406cf73-2174-4ca8-8149-dc49e69d5c2a",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly: make sure today's + tomorrow's Daily Challenge exist, clean up stale rows.
  "triggers": { "crons": ["7 * * * *"] },
  "vars": { "SITE_URL": "https://wikirace.seddikbachounda.com" },
  "observability": { "enabled": true }
}
